# ROUTES — local environment configuration.
# Copy to .env (or run scripts/init-env.sh / scripts/init-env.ps1, which also
# generates random secrets). Never commit .env.

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=routes
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=routes

# ---- Internal service tokens (random, 32+ characters) ----------------------
# Shared by api/worker and the Sandbox Manager.
SANDBOX_MANAGER_TOKEN=change-me-sandbox-manager-token
# Shared by the Sandbox Manager and the network gateway's control API.
GATEWAY_CONTROL_TOKEN=change-me-gateway-control-token

# ---- Web / sessions -------------------------------------------------------
# Origins allowed to make state-changing requests (comma separated).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true only when serving ROUTES over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
# Host port for the web interface (bound to 127.0.0.1).
WEB_PORT=3000
# Host port for direct API access (127.0.0.1 only; used by scripts/e2e.py).
API_PORT=8000

# ---- Assessment limits ----------------------------------------------------
ASSESSMENT_HISTORY_LIMIT=5
MAX_CRAWL_PAGES=25
DISCOVERY_TIMEOUT_SECONDS=600
SOURCE_TIMEOUT_SECONDS=900

# ---- Remediation loop -------------------------------------------------------
# Two different external LLMs, both OpenAI-compatible chat-completions APIs.
# Only worker-remediate has internet access, and it only ever sends them the
# redacted report/snapshot. Defaults below use free tiers:
# LLM A (writes LLM B's prompt and the testbench): Groq - https://console.groq.com
LLM_A_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_A_API_KEY=
LLM_A_MODEL=llama-3.3-70b-versatile
# LLM B (a different model from A; writes the fixed code): OpenRouter free
# tier, a coder-tuned model - https://openrouter.ai
LLM_B_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_B_API_KEY=
LLM_B_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# "live": always call out. "record": call out and save the response so the
# demo can replay it offline later. "replay": never call out, read from the
# cache, error clearly on a miss.
LLM_CACHE_MODE=live
LLM_CACHE_DIR=/tmp/llm_cache
BATCH_SIZE=8
LLM_CONCURRENCY=4
MAX_ROUNDS=5
STAGNATION_ROUNDS=2
REMEDIATION_TOKEN_BUDGET=8000

# ---- DEVELOPMENT ONLY -----------------------------------------------------
# Hostnames the gateway may reach even though they resolve to private
# addresses. Used for the bundled sample site (docker compose --profile
# testing). Leave EMPTY for real use: anything listed here bypasses SSRF
# protection for that exact hostname.
GATEWAY_DEV_ALLOW_HOSTS=
